    "constrained_attack": "one benign donor STREAM per attacker STREAM; attacker window k (t_end order) receives donor window k (t_end order); best-of-K over K candidate donor STREAMS, white-box per model.",
    "pool_matched_control": "same restricted donor pool as the constrained attack (streams of length >= m) but per-window independent donor WINDOWS drawn from the union of those streams' windows + per-window best-of-K -- isolates temporal coherence from the pool restriction. Control RNG seed 108 (kept off the main stream).",
    "grouping": "`groups` = physical transmitter id (leakage-safe grouping used throughout the project); `t_end` orders windows within a stream, ties broken by row index.",
    "donor_pool": "benign TRAIN windows (identical to the published attack), grouped into streams; feasible pool for an m-window attacker stream = benign streams of length >= m.",
    "selection_objectives": {
      "mean_score (PRIMARY)": "argmin_j mean over the stream's windows of the model score -- the group-level lift of the per-window score minimum",
      "min_flagged (sensitivity)": "argmin_j #windows above threshold, ties broken by mean score -- the attacker-optimal choice under the same constraint"
    },
    "fallbacks": {
      "pool_smaller_than_K": "all unique feasible donor streams are used; candidate axis padded by repetition (duplicates cannot change a min). The reduced option set is part of the constraint's cost and is reported.",
