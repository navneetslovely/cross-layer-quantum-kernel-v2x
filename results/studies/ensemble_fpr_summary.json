  "fusion_cost_accounting": {
    "setting": "A5 cross-receiver fusion (scripts/crossreceiver_fusion.py): windows of one claimed sender pooled across receivers per 20 s time bin",
    "communication_overhead": "each receiver reports one 19-float window feature vector (+ ids) per observed sender per 20 s bin ~= 19*4 B + 16 B ids ~= 92 B; at 50 senders/receiver that is ~4.6 kB per receiver per bin (~0.23 kB/s) -- negligible vs 10 Hz BSM traffic (~300 B/beacon ~= 3 kB/s per sender)",
    "latency": "decision latency is bounded by the bin close: up to 20 s + backhaul; unsuitable for pre-crash reaction, aimed at revocation/misbehaviour-authority reporting timescales",
    "trust_assumptions": "the aggregator (RSU/edge) is honest; receiver reports are authenticated; a compromised reporting receiver can poison fused features (not modelled)",
    "coordination_cost": "receivers need ~1 s-level time sync for bin alignment (GNSS time suffices); no inter-receiver channel needed (star topology to the aggregator)"
  },
